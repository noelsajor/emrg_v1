---
import type { SiteSettings } from '../types';
import { getClient } from '../sanity/client';
import { getSiteSettings } from '../sanity/queries';

export interface Props {
  settings?: SiteSettings;
}

const { settings: _settings } = Astro.props;
const settings = _settings ?? await getSiteSettings(getClient());
const calendlyUrl = settings.calendlyUrl ?? 'https://cal.com/emrg';
---
<section id="cta" aria-labelledby="cta-h">
  <div class="cta-grid">
    <div class="cta-left sr">
      <div class="cta-eyebrow" data-i18n="cta.eyebrow">Ready to begin?</div>
      <h2 class="cta-title" id="cta-h" data-i18n-html="cta.title">Let’s engineer your <em>advantage</em>.</h2>
    </div>
    <div class="cta-right sr sr-d1">
      <p class="cta-body-text" data-i18n="cta.desc">We are currently accepting new projects for Q3 2026. Schedule a discovery call to discuss your goals and receive a custom roadmap.</p>
      <div class="cta-actions">
        <a href={calendlyUrl} class="btn-cta-primary">
          <span data-i18n="cta.primary">Book Discovery Call</span>
          <span>→</span>
        </a>
        <a href="mailto:hello@emrg.studio" class="btn-cta-secondary">
          <span data-i18n="cta.secondary">Email hello@emrg.studio</span>
        </a>
      </div>
      <div class="cta-note" data-i18n="cta.note">Typical response time: < 24 hours</div>
    </div>
  </div>
</section>
