---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CtaSection from '../components/CtaSection.astro';
---

<BaseLayout title="Enfoque Retail y Mayoristas | EMRG" description="Gestión integral de marketing digital para negocios que venden en grande. Tiendas online de alto rendimiento y SEO para catálogos masivos.">
  <Nav />
  
  <main id="retail-focus" class="bg-bg text-white">
    <section class="pt-32 lg:pt-40 pb-20 bg-bg">
      <div class="container grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-16 items-center">
        <div>
          <p class="inline-flex items-center gap-2 text-[0.8rem] font-bold uppercase tracking-[0.1em] text-accent mb-6 before:w-2 before:h-2 before:rounded-full before:bg-accent before:shadow-[0_0_15px_#7360f8]">Sector Retail</p>
          <h1 class="text-[clamp(1.8rem,4vw,2.8rem)] leading-tight mb-8 max-w-[18ch] tracking-[-0.02em] text-white">Lleva tu inventario a las pantallas de tus <span class="text-accent">clientes ideales.</span></h1>
          <p class="text-[1.1rem] text-gray-2 max-w-[50ch] mb-10 leading-relaxed">Gestión integral de marketing digital para negocios que venden en grande. Construimos la infraestructura que soporta tu crecimiento masivo.</p>
          <div class="flex gap-4 mb-8">
            <a href="#contacto" class="btn btn-primary">Escalar mis Ventas</a>
            <a href="#solucion" class="btn btn-secondary">Ver Servicios</a>
          </div>
        </div>
        <div class="relative rounded-lg border border-white/10 shadow-[0_0_50px_rgba(139,92,246,0.15)] w-full lg:order-[-1]">
          <img src="/images/hero-retail.png" alt="Retail Management Dashboard" class="w-full h-auto rounded-lg block object-cover" width={640} height={640} loading="eager" decoding="async" />
        </div>
      </div>
    </section>

    <section class="py-24 bg-bg-2">
       <div class="container">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
             <div class="bg-bg-card border border-white/10 p-10 rounded transition-all duration-300 hover:border-accent hover:-translate-y-1">
                <span class="text-[0.85rem] text-accent mb-6 font-extrabold block">01</span>
                <h3 class="text-[1.5rem] mb-4 leading-tight">Tiendas de Alto Rendimiento</h3>
                <p>E-commerce robusto preparado para manejar catálogos masivos y picos de tráfico extremo.</p>
             </div>
             <div class="bg-bg-card border border-white/10 p-10 rounded transition-all duration-300 hover:border-accent hover:-translate-y-1">
                <span class="text-[0.85rem] text-accent mb-6 font-extrabold block">02</span>
                <h3 class="text-[1.5rem] mb-4 leading-tight">SEO de Categorías</h3>
                <p>Posicionamiento estratégico para productos específicos y categorías de alta demanda en el mercado.</p>
             </div>
             <div class="bg-bg-card border border-white/10 p-10 rounded transition-all duration-300 hover:border-accent hover:-translate-y-1">
                <span class="text-[0.85rem] text-accent mb-6 font-extrabold block">03</span>
                <h3 class="text-[1.5rem] mb-4 leading-tight">Growth Automatizado</h3>
                <p>Email Marketing para carritos abandonados y promociones inteligentes que cierran ventas solos.</p>
             </div>
          </div>
       </div>
    </section>

    <section id="resultados" class="py-24">
      <div class="container">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-24 items-center">
          <div>
            <h2 class="text-[clamp(2rem,3.5vw,3rem)] mb-10 leading-none tracking-[-0.03em]">Enfoque en <span class="text-accent-light">Resultados.</span></h2>
            <p class="text-[1.1rem] text-gray-2 leading-relaxed mb-12">No solo gestionamos, escalamos. Nuestras estrategias están diseñadas para convertir el tráfico en ingresos predecibles y sostenibles.</p>
            
            <div class="grid gap-6">
               <div>
                  <strong class="block text-white mb-[0.6rem] text-base">+45% Conversión</strong>
                  <div class="w-full h-1 bg-border rounded-full"><div class="h-full bg-accent rounded-full relative" style="width:85%"></div></div>
               </div>
               <div>
                  <strong class="block text-white mb-[0.6rem] text-base">+120% Tráfico Orgánico</strong>
                  <div class="w-full h-1 bg-border rounded-full"><div class="h-full bg-accent rounded-full relative" style="width:95%"></div></div>
               </div>
            </div>
          </div>
          <div class="text-2xl md:text-[2rem] leading-tight italic text-white/90">
            <blockquote>
              &ldquo;Estrategias de contenido integral que convierten seguidores en compradores.&rdquo;
            </blockquote>
          </div>
        </div>
      </div>
    </section>

    <section id="solucion" class="py-24 bg-bg-2">
      <div class="container">
        <h2 class="text-[clamp(2rem,3.5vw,3rem)] mb-10 leading-none tracking-[-0.03em]">Servicios <span class="text-accent">Clave.</span></h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-bg-card border border-white/10 p-10 rounded-lg">
            <h3 class="text-[1.8rem] mb-5 text-white">E-commerce Enterprise</h3>
            <p>Arquitectura web optimizada para catálogos dinámicos y transacciones fluidas de gran volumen.</p>
          </div>
          <div class="bg-bg-card border border-white/10 p-10 rounded-lg">
            <h3 class="text-[1.8rem] mb-5 text-white">Automatización CRM</h3>
            <p>Retención de clientes mediante flujos de email marketing que recuperan ventas perdidas.</p>
          </div>
          <div class="bg-bg-card border border-white/10 p-10 rounded-lg">
            <h3 class="text-[1.8rem] mb-5 text-white">SEO para Retail</h3>
            <p>Visibilidad orgánica total para tus términos de búsqueda más rentables y categorías estrella.</p>
          </div>
          <div class="bg-bg-card border border-white/10 p-10 rounded-lg">
            <h3 class="text-[1.8rem] mb-5 text-white">Social Cataloging</h3>
            <p>Gestión de redes sociales enfocada en catálogos de producto que impulsan la compra directa.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="contacto" class="py-24">
      <div class="container">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-20 items-start">
          <div>
            <h2 class="text-[clamp(2rem,3.5vw,3rem)] mb-10 leading-none tracking-[-0.03em]">Hablemos de cómo <br/><span class="text-accent">escalar tus ventas.</span></h2>
            <p>Completa el formulario y diseñaremos una hoja de ruta para llevar tu inventario al siguiente nivel digital este mismo mes.</p>
            <div class="mt-10 grid gap-4 text-base text-accent-light">
               <div>✓ Auditoría de infraestructura actual</div>
               <div>✓ Análisis de competencia en categorías</div>
               <div>✓ Plan de automatización de ventas</div>
            </div>
          </div>
          <form class="grid gap-6 bg-bg-card p-12 border border-white/10 rounded-lg retail-form">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
               <input type="text" placeholder="Tu Nombre" required class="bg-black/20 border border-white/10 p-[1.1rem] text-white font-body w-full rounded-sm text-[0.95rem] focus:outline-none focus:border-accent" />
               <input type="text" placeholder="Empresa / Retailer" required class="bg-black/20 border border-white/10 p-[1.1rem] text-white font-body w-full rounded-sm text-[0.95rem] focus:outline-none focus:border-accent" />
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
               <input type="text" placeholder="Volumen de Catálogo" required class="bg-black/20 border border-white/10 p-[1.1rem] text-white font-body w-full rounded-sm text-[0.95rem] focus:outline-none focus:border-accent" />
               <input type="text" placeholder="Ciudad" required class="bg-black/20 border border-white/10 p-[1.1rem] text-white font-body w-full rounded-sm text-[0.95rem] focus:outline-none focus:border-accent" />
            </div>
            <textarea placeholder="¿Cuál es tu meta de ventas para este trimestre?" required class="bg-black/20 border border-white/10 p-[1.1rem] text-white font-body w-full rounded-sm text-[0.95rem] focus:outline-none focus:border-accent h-[110px] resize-none"></textarea>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
               <input type="email" placeholder="Email Corporativo" required class="bg-black/20 border border-white/10 p-[1.1rem] text-white font-body w-full rounded-sm text-[0.95rem] focus:outline-none focus:border-accent" />
               <input type="tel" placeholder="WhatsApp" required class="bg-black/20 border border-white/10 p-[1.1rem] text-white font-body w-full rounded-sm text-[0.95rem] focus:outline-none focus:border-accent" />
            </div>
            <button type="submit" class="btn btn-primary w-full">Hablemos hoy</button>
            <p class="success-msg mt-4 text-accent" style="display:none;">Diseñaremos tu estrategia de escalado. Nos pondremos en contacto muy pronto.</p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <CtaSection />
  <Footer />
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.querySelector('.retail-form');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        form.reset();
        const success = form.querySelector('.success-msg');
        if (success) success.style.display = 'block';
      });
    }
  });
</script>
