---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CtaSection from '../components/CtaSection.astro';
---

<BaseLayout title="Enfoque Emprendedores y PYMES | EMRG" description="Diseño de sitios web desde cero y optimización estratégica para que tu marca despegue. Deja de ser invisible y captura clientes 24/7.">
  <Nav />
  
  <main class="bg-bg">
    <section class="min-h-[80vh] flex items-center pt-16 pb-16 lg:pt-40 lg:pb-24 bg-bg">
      <div class="max-w-[1200px] mx-auto px-10 grid grid-cols-[1.1fr_0.9fr] gap-16 items-center lg:grid-cols-1">
        <div class="z-[2]">
          <p class="inline-flex items-center gap-2.5 text-[0.75rem] font-bold tracking-[0.15em] uppercase text-accent-light mb-6 before:w-5 before:h-px before:bg-accent-light before:content-['']">Digital Growth</p>
          <h1 class="text-[clamp(2rem,4.5vw,3.2rem)] leading-[1.1] font-extrabold tracking-[-0.04em] mb-7 max-w-[18ch] font-display text-white">Deja de ser invisible. Es hora de que el mundo <span class="text-accent-light">encuentre tu negocio.</span></h1>
          <p class="text-[1.15rem] text-gray-2 max-w-[50ch] leading-[1.6] mb-10">
            Diseño de sitios web desde cero y optimización estratégica para que tu marca despegue. 
            Construimos la base técnica que tu visión merece.
          </p>
          
          <div class="flex gap-4 mb-12">
            <a class="inline-block bg-accent-light text-bg font-bold py-3.5 px-7 rounded-lg transition-all duration-300 hover:bg-white hover:-translate-y-0.5 no-underline text-center" href="#contacto">¡Sí, quiero lanzar mi negocio!</a>
            <a class="inline-block border border-white/10 text-white font-bold py-3.5 px-7 rounded-lg transition-all duration-300 hover:border-accent-light no-underline text-center" href="#hook">Saber más</a>
          </div>

          <ul class="list-none flex flex-col gap-3" aria-label="Beneficios clave">
            <li class="flex items-center gap-3 text-[0.9rem] text-gray-1 font-medium before:w-1.5 before:h-1.5 before:rounded-full before:bg-accent-light before:content-['']">Ventas 24/7 ininterrumpidas</li>
            <li class="flex items-center gap-3 text-[0.9rem] text-gray-1 font-medium before:w-1.5 before:h-1.5 before:rounded-full before:bg-accent-light before:content-['']">Alcance nacional y escalable</li>
            <li class="flex items-center gap-3 text-[0.9rem] text-gray-1 font-medium before:w-1.5 before:h-1.5 before:rounded-full before:bg-accent-light before:content-['']">Imagen profesional y sólida</li>
          </ul>
        </div>

        <div class="relative rounded-2xl overflow-hidden border border-white/10 shadow-card aspect-[16/11] order-first lg:order-none">
          <img src="/images/hero-pymes.png" alt="Crecimiento Digital PYMES" class="object-cover w-full h-full" width={640} height={640} loading="eager" decoding="async" />
        </div>
      </div>
    </section>

    <section id="hook" class="py-16 lg:py-24 bg-bg-2">
      <div class="max-w-[1200px] mx-auto px-10">
        <div class="bg-bg-card border border-white/10 p-16 text-center rounded-2xl max-w-[900px] mx-auto reveal">
          <h2 class="text-[clamp(1.8rem,3.5vw,2.8rem)] leading-[1.2] mb-5 font-display">¿Sabías que el <span class="text-accent-light">80% de las personas</span> investigan en internet antes de comprar?</h2>
          <p class="text-[1.1rem] text-gray-2 leading-[1.6]">Si no estás allí cuando te buscan, estás regalando tus clientes a la competencia. En EMRG transformamos tu presencia digital en un motor de ventas constante.</p>
        </div>
      </div>
    </section>

    <section class="py-16 lg:py-24">
       <div class="max-w-[1200px] mx-auto px-10">
          <h2 class="text-[clamp(2rem,4vw,3rem)] mb-12 tracking-[-0.03em] font-display">Beneficios de <span class="text-accent-light">Impacto Real.</span></h2>
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
             <div class="bg-bg-card border border-white/10 p-10 rounded-[16px] transition-all duration-300 hover:border-accent-light hover:-translate-y-1">
                <div class="text-accent-light mb-6">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <h3 class="text-2xl mb-4 font-display">Ventas 24/7</h3>
                <p class="text-gray-2 text-[0.9rem]">Tu negocio nunca cierra. Recibe pedidos y consultas mientras duermes o te enfocas en operar.</p>
             </div>
             <div class="bg-bg-card border border-white/10 p-10 rounded-[16px] transition-all duration-300 hover:border-accent-light hover:-translate-y-1">
                <div class="text-accent-light mb-6">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <h3 class="text-2xl mb-4 font-display">Alcance Nacional</h3>
                <p class="text-gray-2 text-[0.9rem]">Rompe las barreras geográficas y llega a clientes en todo el país con una logística simplificada.</p>
             </div>
             <div class="bg-bg-card border border-white/10 p-10 rounded-[16px] transition-all duration-300 hover:border-accent-light hover:-translate-y-1">
                <div class="text-accent-light mb-6">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <h3 class="text-2xl mb-4 font-display">Profesionalismo</h3>
                <p class="text-gray-2 text-[0.9rem]">Gana la confianza de tus clientes con una imagen sólida que valida la calidad de tu trabajo.</p>
             </div>
          </div>
       </div>
    </section>

    <section id="servicios" class="py-16 lg:py-24">
      <div class="max-w-[1200px] mx-auto px-10">
        <h2 class="text-[clamp(2rem,4vw,3rem)] mb-12 tracking-[-0.03em] font-display">Paquetes de <span class="text-accent-light">Despegue.</span></h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div class="bg-bg-card border border-white/10 p-10 rounded-[16px]">
            <h3 class="text-2xl mb-4 font-display">Creación de Tienda Online</h3>
            <p class="text-gray-2 text-[0.9rem]">E-commerce fácil de usar, autogestionable y diseñado para maximizar conversiones.</p>
          </div>
          <div class="bg-bg-card border border-white/10 p-10 rounded-[16px]">
            <h3 class="text-2xl mb-4 font-display">Optimización SEO</h3>
            <p class="text-gray-2 text-[0.9rem]">Aparece en los primeros resultados desde el día 1. No solo hacemos webs, hacemos que te encuentren.</p>
          </div>
          <div class="bg-bg-card border border-white/10 p-10 rounded-[16px]">
            <h3 class="text-2xl mb-4 font-display">Gestión de Contenidos</h3>
            <p class="text-gray-2 text-[0.9rem]">No te preocupes por qué escribir. Nosotros creamos el copy que conecta con tu audiencia por ti.</p>
          </div>
          <div class="bg-bg-card border border-white/10 p-10 rounded-[16px]">
            <h3 class="text-2xl mb-4 font-display">Soporte Estratégico</h3>
            <p class="text-gray-2 text-[0.9rem]">Acompañamiento continuo para que tu negocio siga escalando al ritmo del mercado.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 lg:py-24">
      <div class="max-w-[1200px] mx-auto px-10">
        <h2 class="text-[clamp(2rem,4vw,3rem)] mb-12 tracking-[-0.03em] text-center font-display">Lo que dicen <span class="text-accent-light">nuestros clientes.</span></h2>
        <div class="max-w-[800px] mx-auto mt-10 bg-bg-card border border-white/10 rounded-2xl p-5" id="pymes-carousel">
          <div class="carousel-track">
            <div class="testimonial-card active">
              <p class="text-[1.4rem] italic mb-6">"Pasamos de vender localmente a enviar a todo el país en menos de un mes. El sistema que montaron es impecable."</p>
              <div class="text-[0.8rem] uppercase text-accent-light font-bold">Fundadora — Tienda de Diseño</div>
            </div>
            <div class="testimonial-card">
              <p class="text-[1.4rem] italic mb-6">"Por primera vez mi negocio aparece primero en Google. La inversión se recuperó en apenas dos semanas."</p>
              <div class="text-[0.8rem] uppercase text-accent-light font-bold">Dueño — Empresa de Distribución</div>
            </div>
            <div class="testimonial-card">
              <p class="text-[1.4rem] italic mb-6">"No tenía tiempo para la web ni los textos. Se encargaron de todo y el resultado es más profesional de lo que imaginé."</p>
              <div class="text-[0.8rem] uppercase text-accent-light font-bold">Gerente — Boutique de Servicios</div>
            </div>
          </div>
          <div class="flex justify-center gap-2 mt-5">
            <button class="dot active" aria-label="Go to slide 1"></button>
            <button class="dot" aria-label="Go to slide 2"></button>
            <button class="dot" aria-label="Go to slide 3"></button>
          </div>
        </div>
      </div>
    </section>

    <section id="contacto" class="py-16 lg:py-24">
      <div class="max-w-[1200px] mx-auto px-10">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.1fr] gap-16 items-center">
          <div>
            <h2 class="text-[clamp(2rem,4vw,3rem)] mb-12 tracking-[-0.03em] font-display">¡Sí, quiero lanzar mi negocio al <br/><span class="text-accent-light">mundo digital!</span></h2>
            <p class="text-gray-2 text-lg">Completa el formulario y reserva tu auditoría gratuita. Es el primer paso para dejar de ser invisible.</p>
            <div class="flex flex-col gap-3 mt-8">
               <div class="text-gray-1">✓ Análisis de competencia online</div>
               <div class="text-gray-1">✓ Plan de digitalización personalizado</div>
               <div class="text-gray-1">✓ Presupuesto sin sorpresas</div>
            </div>
          </div>
          <form class="bg-bg-2 p-10 border border-white/10 rounded-2xl pymes-form">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
               <input type="text" placeholder="Tu Nombre completo" required class="bg-bg border border-white/10 p-3.5 text-white w-full rounded-lg font-body" />
               <input type="text" placeholder="Nombre de tu negocio" required class="bg-bg border border-white/10 p-3.5 text-white w-full rounded-lg font-body" />
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
               <select required class="bg-bg border border-white/10 p-3.5 text-white w-full rounded-lg font-body">
                  <option value="">Tu objetivo hoy</option>
                  <option>Crear mi primera web</option>
                  <option>Montar una tienda online</option>
                  <option>Mejorar mi web actual</option>
                  <option>Ganar más clientes</option>
               </select>
               <input type="tel" placeholder="WhatsApp para contactarte" required class="bg-bg border border-white/10 p-3.5 text-white w-full rounded-lg font-body" />
            </div>
            <textarea placeholder="Cuéntanos brevemente sobre tu negocio y qué te gustaría lograr..." required class="bg-bg border border-white/10 p-3.5 text-white w-full rounded-lg font-body"></textarea>
            <input type="email" placeholder="Email corporativo / personal" required class="bg-bg border border-white/10 p-3.5 text-white w-full rounded-lg font-body" />
            <button type="submit" class="inline-block bg-accent-light text-bg font-bold py-3.5 px-7 rounded-lg transition-all duration-300 hover:bg-white hover:-translate-y-0.5 no-underline text-center w-full">Solicitar Auditoría Ahora</button>
            <p class="success-msg mt-4 text-accent-light font-extrabold" style="display:none">¡Recibido! Nos pondremos en contacto muy pronto para despegar tu negocio.</p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <CtaSection />
  <Footer />
</BaseLayout>

<style>
  .carousel-track { display: flex; transition: transform 0.6s ease; }
  .testimonial-card { min-width: 100%; padding: 40px; text-align: center; opacity: 0; transition: opacity 0.4s; }
  .testimonial-card.active { opacity: 1; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,0.07); border: none; cursor: pointer; }
  .dot.active { background: #bc9bf2; transform: scale(1.3); }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Form logic
    const form = document.querySelector('.pymes-form');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        form.reset();
        const success = form.querySelector('.success-msg');
        if (success) success.style.display = 'block';
      });
    }

    // Carousel logic
    const track = document.querySelector('.carousel-track');
    const slides = Array.from(track.children);
    const dts = Array.from(document.querySelectorAll('.dot'));
    let curIdx = 0;

    function updCarousel(idx) {
      track.style.transform = `translateX(-${idx * 100}%)`;
      slides.forEach((s, i) => s.classList.toggle('active', i === idx));
      dts.forEach((d, i) => d.classList.toggle('active', i === idx));
      curIdx = idx;
    }

    dts.forEach((d, i) => d.addEventListener('click', () => updCarousel(i)));
    setInterval(() => updCarousel((curIdx + 1) % slides.length), 5000);
  });
</script>
