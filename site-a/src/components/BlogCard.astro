---
import { urlFor } from '../lib/image';
import { formatBlogDate } from '@emrg/shared';

interface Props {
  post: {
    title: string;
    slug: { current: string };
    mainImage?: any;
    publishedAt: string;
    excerpt?: string;
    author?: { name: string; image?: any };
    categories?: { title: string }[];
  };
}

const { post } = Astro.props;
const formattedDate = formatBlogDate(post.publishedAt);
---

<article class="bg-bg-2 border border-gray-4 rounded-xl overflow-hidden transition-all duration-300 hover:border-accent hover:-translate-y-1 hover:shadow-[0_12px_24px_rgba(0,0,0,0.4)] reveal">
  <a href={`/blog/${post.slug.current}`} class="block text-inherit no-underline">
    {post.mainImage && (
      <div class="aspect-[3/2] overflow-hidden bg-[#1a1e26]">
        <img 
          src={urlFor(post.mainImage).width(600).height(400).url()} 
          alt={post.title} 
          loading="lazy"
          decoding="async"
          width={600} height={400}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      </div>
    )}
    <div class="p-6">
      <div class="flex gap-3 items-center mb-3 text-sm text-gray-2">
        {post.categories?.[0] && <span class="text-accent-light font-semibold uppercase tracking-wide">{post.categories[0].title}</span>}
        <span>{formattedDate}</span>
      </div>
      <h3 class="text-xl font-bold leading-tight mb-3 text-white">{post.title}</h3>
      {post.excerpt && <p class="text-sm text-gray-2 leading-relaxed mb-5 line-clamp-2">{post.excerpt}</p>}
      <div class="pt-4 border-t border-gray-4">
        <span class="inline-flex items-center gap-2 text-sm font-semibold text-accent-light hover:text-accent transition-colors duration-300">
          Read Article
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </div>
    </div>
  </a>
</article>
