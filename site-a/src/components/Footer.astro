---
import type { SiteSettings } from '@emrg/shared/types';
import { getSiteSettings } from '@emrg/shared/sanity/queries';
import { getClient } from '@emrg/shared/sanity/client';

export interface Props {
  settings?: SiteSettings;
}

const s = Astro.props.settings ?? await getSiteSettings(getClient());

const columns = s.footerColumns.length > 0 ? s.footerColumns : null;
const socials = s.socialLinks.length > 0 ? s.socialLinks : null;
const footerText = s.footerText || 'Founder-led ecommerce performance studio. We design the brand, build the store, and engineer the growth system.';

// Map social links by platform for SVG icon hrefs (icons stay in code)
const twitterUrl = socials?.find(link => link.platform === 'twitter' || link.platform === 'x')?.url || '#';
const linkedinUrl = socials?.find(link => link.platform === 'linkedin')?.url || '#';
const instagramUrl = socials?.find(link => link.platform === 'instagram')?.url || '#';

const copyrightText = (s.copyright || `© ${new Date().getFullYear()} EMRG. All rights reserved.`).replace('{year}', String(new Date().getFullYear()));
---

<footer class="bg-bg-2 border-t border-border py-16 pb-10">
  <div class="container">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1fr_auto_auto_auto] gap-[60px] mb-[60px] items-start">
      <div class="footer-brand">
        <a href="/" class="inline-block mb-3">
          <img src="/images/emrg-logo.png" alt="EMRG Logo" class="logo-img h-7 w-auto block" width={300} height={61} loading="lazy" decoding="async" />
        </a>
        <p class="text-sm text-gray-2 leading-relaxed max-w-[240px] mb-5" data-i18n="footer.tagline">{footerText}</p>
        <div class="flex gap-3" role="list">
          <a href={twitterUrl} class="w-9 h-9 bg-bg-card border border-border rounded-lg flex items-center justify-center text-gray-2 text-sm font-bold transition-all duration-300 hover:border-accent hover:text-accent-light hover:bg-[rgba(115,96,248,0.15)]" aria-label="X (Twitter)" role="listitem"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg></a>
          <a href={linkedinUrl} class="w-9 h-9 bg-bg-card border border-border rounded-lg flex items-center justify-center text-gray-2 text-sm font-bold transition-all duration-300 hover:border-accent hover:text-accent-light hover:bg-[rgba(115,96,248,0.15)]" aria-label="LinkedIn" role="listitem"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></a>
          <a href={instagramUrl} class="w-9 h-9 bg-bg-card border border-border rounded-lg flex items-center justify-center text-gray-2 text-sm font-bold transition-all duration-300 hover:border-accent hover:text-accent-light hover:bg-[rgba(115,96,248,0.15)]" aria-label="Instagram" role="listitem"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg></a>
        </div>
      </div>

      {columns
        ? columns.map(col => (
            <div>
              <h4 class="text-[0.72rem] font-bold tracking-[0.12em] uppercase text-gray-3 mb-4">{col.title}</h4>
              <ul class="list-none flex flex-col gap-2.5" role="list">
                {col.links.map(link => (
                  <li><a href={link.href} class="text-sm text-gray-2 font-medium hover:text-white transition-colors duration-300" data-i18n={link.dataI18n || undefined}>{link.title}</a></li>
                ))}
              </ul>
            </div>
          ))
        : (
            <>
              <div>
                <h4 class="text-[0.72rem] font-bold tracking-[0.12em] uppercase text-gray-3 mb-4" data-i18n="footer.col.services">Services</h4>
                <ul class="list-none flex flex-col gap-2.5" role="list">
                  <li><a href="#pillars" class="text-sm text-gray-2 font-medium hover:text-white transition-colors duration-300" data-i18n="footer.link.ecommerce">Ecommerce Builds</a></li>
                  <li><a href="#pillars" class="text-sm text-gray-2 font-medium hover:text-white transition-colors duration-300" data-i18n="footer.link.growth">Growth Systems</a></li>
                  <li><a href="#pillars" class="text-sm text-gray-2 font-medium hover:text-white transition-colors duration-300" data-i18n="footer.link.cro">CRO & Optimization</a></li>
                </ul>
              </div>

              <div>
                <h4 class="text-[0.72rem] font-bold tracking-[0.12em] uppercase text-gray-3 mb-4" data-i18n="footer.col.company">Company</h4>
                <ul class="list-none flex flex-col gap-2.5" role="list">
                  <li><a href="#work" class="text-sm text-gray-2 font-medium hover:text-white transition-colors duration-300">Work</a></li>
                  <li><a href="#process" class="text-sm text-gray-2 font-medium hover:text-white transition-colors duration-300">Process</a></li>
                  <li><a href="#packages" class="text-sm text-gray-2 font-medium hover:text-white transition-colors duration-300">Packages</a></li>
                </ul>
              </div>

              <div>
                <h4 class="text-[0.72rem] font-bold tracking-[0.12em] uppercase text-gray-3 mb-4" data-i18n="footer.col.follow">Follow</h4>
                <ul class="list-none flex flex-col gap-2.5" role="list">
                  <li><a href="#" class="text-sm text-gray-2 font-medium hover:text-white transition-colors duration-300">X / Twitter</a></li>
                  <li><a href="#" class="text-sm text-gray-2 font-medium hover:text-white transition-colors duration-300">LinkedIn</a></li>
                  <li><a href="#" class="text-sm text-gray-2 font-medium hover:text-white transition-colors duration-300">Instagram</a></li>
                </ul>
              </div>
            </>
          )
      }
    </div>

    <div class="border-t border-border pt-7 flex items-center justify-between flex-wrap gap-4">
      <div class="text-[0.78rem] text-gray-3">{copyrightText}</div>
      <div class="flex gap-6">
        <a href="#" class="text-[0.78rem] text-gray-3 hover:text-gray-2 transition-colors duration-300" data-i18n="footer.privacy">Privacy Policy</a>
        <a href="#" class="text-[0.78rem] text-gray-3 hover:text-gray-2 transition-colors duration-300" data-i18n="footer.terms">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
