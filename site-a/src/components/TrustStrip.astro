<section id="trust" class="py-15 border-t border-b border-border bg-bg-2" aria-label="Key stats">
  <div class="container">
    <div class="flex items-center justify-center gap-0 flex-wrap" role="list">
      <div class="trust-item flex-1 min-w-[200px] text-center py-5 px-10 border-r border-border last:border-r-0 reveal" role="listitem">
        <div class="text-[2.4rem] font-extrabold text-white tracking-tight leading-none mb-1.5">25<span class="text-accent">+</span></div>
        <div class="text-sm text-gray-2 font-medium tracking-wide" data-i18n="trust.stat1">Ecommerce Builds</div>
      </div>
      <div class="trust-item flex-1 min-w-[200px] text-center py-5 px-10 border-r border-border last:border-r-0 reveal reveal-delay-1" role="listitem">
        <div class="text-[2.4rem] font-extrabold text-white tracking-tight leading-none mb-1.5">5<span class="text-accent">–7</span></div>
        <div class="text-sm text-gray-2 font-medium tracking-wide" data-i18n="trust.stat2">Day Avg. Launch</div>
      </div>
      <div class="trust-item flex-1 min-w-[200px] text-center py-5 px-10 border-r border-border last:border-r-0 reveal reveal-delay-2" role="listitem">
        <div class="text-[2.4rem] font-extrabold text-white tracking-tight leading-none mb-1.5"><span class="text-accent">+</span>22<span class="text-accent">%</span></div>
        <div class="text-sm text-gray-2 font-medium tracking-wide" data-i18n="trust.stat3">Avg. CVR Improvement</div>
      </div>
      <div class="trust-item flex-1 min-w-[200px] text-center py-5 px-10 last:border-r-0 reveal reveal-delay-3" role="listitem">
        <div class="text-[2.4rem] font-extrabold text-white tracking-tight leading-none mb-1.5">100<span class="text-accent">%</span></div>
        <div class="text-sm text-gray-2 font-medium tracking-wide" data-i18n="trust.stat4">Conversion-Focused by Default</div>
      </div>
    </div>
    <p class="text-center mt-5 text-[0.72rem] text-gray-3 tracking-wide" data-i18n="trust.disclaimer">Results vary by business, product, and market conditions.</p>
  </div>
</section>
