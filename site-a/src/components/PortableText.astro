---
import { toHTML } from '@portabletext/to-html';
import { urlFor } from '../lib/image';

interface Props {
  value: any;
}

const { value } = Astro.props;

const customComponents = {
  types: {
    image: ({ value }: any) => {
      return `<figure class="my-12 rounded-xl overflow-hidden">
        <img src="${urlFor(value).width(1200).url()}" alt="${value.alt || ''}" class="w-full h-auto block" loading="lazy" decoding="async" width="1200" height="675" />
        ${value.caption ? `<figcaption class="p-3 text-sm text-gray-3 text-center bg-bg-2">${value.caption}</figcaption>` : ''}
      </figure>`;
    },
  },
  block: {
    h2: ({ children }: any) => `<h2 class="text-4xl font-extrabold my-12 mb-6 text-text font-display">${children}</h2>`,
    h3: ({ children }: any) => `<h3 class="text-2xl font-bold my-8 mb-4 text-text font-display">${children}</h3>`,
    normal: ({ children }: any) => `<p class="mb-6 text-gray-2">${children}</p>`,
    blockquote: ({ children }: any) => `<blockquote class="border-l-4 border-accent py-4 px-8 my-10 bg-bg-2 italic text-xl rounded-r-lg">${children}</blockquote>`,
  },
  list: {
    bullet: ({ children }: any) => `<ul class="mb-8 pl-6">${children}</ul>`,
    number: ({ children }: any) => `<ol class="mb-8 pl-6">${children}</ol>`,
  },
  listItem: ({ children }: any) => `<li class="mb-3 text-gray-2 marker:text-accent-light">${children}</li>`,
};

const html = toHTML(value, { components: customComponents });
---

<div class="text-text text-lg leading-relaxed" set:html={html} />
