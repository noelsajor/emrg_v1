---
import { getPosts } from '../lib/sanity';
import BlogCard from './BlogCard.astro';

const posts = await getPosts();
const featuredPosts = posts.slice(0, 3);
---

<section id="blog-teaser" class="py-[100px] bg-bg border-t border-gray-4 md:py-[60px]">
  <div class="container">
    <div class="flex items-end justify-between mb-16 gap-6 flex-wrap">
      <div>
        <div class="inline-flex items-center gap-2.5 text-[0.72rem] font-bold tracking-[0.14em] uppercase text-accent mb-5 before:w-5 before:h-px before:bg-accent">Insights</div>
        <h2 class="section-title text-white text-[clamp(1.8rem,3.5vw,2.8rem)] font-extrabold tracking-tight leading-tight">The Performance Journal</h2>
      </div>
      <a href="/blog" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-lg font-display text-sm font-semibold tracking-wider border cursor-pointer whitespace-nowrap transition-all duration-300 bg-transparent text-white border-border hover:border-accent hover:text-accent-light hover:bg-[rgba(115,96,248,0.15)] hover:-translate-y-px">View All Articles</a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mt-12">
      {featuredPosts.length > 0 ? (
        featuredPosts.map((post: any) => (
          <BlogCard post={post} />
        ))
      ) : (
        <div class="col-span-full text-center py-20 px-10 bg-bg-2 border border-dashed border-gray-3 rounded-xl text-gray-2">
          <p>New insights coming soon. Stay tuned.</p>
        </div>
      )}
    </div>
  </div>
</section>
