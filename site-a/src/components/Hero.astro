---
---

<section id="hero" class="min-h-screen flex flex-col justify-center px-0 py-[calc(72px+80px)] pb-[100px] relative overflow-hidden bg-bg" aria-labelledby="hero-heading">
  <div class="hero-bg absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="hero-grid"></div>
    <div class="hero-orb hero-orb-1 !w-[600px] !h-[600px] bg-accent -top-[200px] -right-[100px]"></div>
    <div class="hero-orb hero-orb-2 !w-[400px] !h-[400px] bg-accent-2 -bottom-[100px] -left-[100px]"></div>
  </div>

  <div class="container relative z-[1] max-w-[900px]">
    <div class="hero-badge inline-flex items-center gap-2 px-3.5 py-1.5 pl-2 bg-[rgba(115,96,248,0.15)] border border-[rgba(139,92,246,0.25)] rounded-full text-[0.78rem] font-semibold text-accent-light tracking-widest uppercase mb-8">
      <span class="dot w-[6px] h-[6px] bg-accent rounded-full" style="animation:pulse 2s infinite"></span>
      <span data-i18n="hero.badge">Accepting Projects</span>
    </div>

    <h1 id="hero-heading">
      <span class="block text-white text-[clamp(2.4rem,6vw,4.8rem)] font-extrabold leading-[1.08] tracking-tight mb-7 font-display" data-i18n="hero.h1.line1">We design the brand.</span>
      <span class="block text-white text-[clamp(2.4rem,6vw,4.8rem)] font-extrabold leading-[1.08] tracking-tight mb-7 font-display" data-i18n="hero.h1.line2">We build the store.</span>
      <span class="block text-white text-[clamp(2.4rem,6vw,4.8rem)] font-extrabold leading-[1.08] tracking-tight mb-7 font-display">We <span class="text-accent-light" data-i18n="hero.h1.line3.accent">engineer</span> <span data-i18n="hero.h1.line3.rest">the</span></span>
      <span class="block text-white text-[clamp(2.4rem,6vw,4.8rem)] font-extrabold leading-[1.08] tracking-tight mb-7 font-display" data-i18n="hero.h1.line4">growth system.</span>
    </h1>

    <p class="text-base text-gray-2 max-w-[520px] mb-11 leading-relaxed font-normal" data-i18n="hero.sub">
      End-to-end ecommerce execution — from brand identity and packaging to store build, conversion engineering, and post-launch growth infrastructure. Built for DTC brands that mean business.
    </p>

    <div class="flex items-center gap-4 flex-wrap mb-16">
      <a href="#cta" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-lg font-display text-sm font-semibold tracking-wider border-none cursor-pointer whitespace-nowrap transition-all duration-300 bg-accent text-white hover:bg-accent-light hover:shadow-[0_0_30px_rgba(139,92,246,0.4)] hover:-translate-y-px" id="hero-cta-primary">
        <span data-i18n="hero.cta.primary">Book a 15-min Call</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a href="#work" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-lg font-display text-sm font-semibold tracking-wider border cursor-pointer whitespace-nowrap transition-all duration-300 bg-transparent text-white border-border hover:border-accent hover:text-accent-light hover:bg-[rgba(115,96,248,0.15)] hover:-translate-y-px" data-i18n="hero.cta.secondary">View Work</a>
    </div>

    <div class="flex gap-3 flex-wrap" role="list">
      <div class="chip inline-flex items-center gap-2 px-4 py-2 bg-bg-card border border-border rounded-full text-sm font-semibold text-gray-1 tracking-wide" role="listitem" data-i18n="hero.chip1">7-Day Launch</div>
      <div class="chip inline-flex items-center gap-2 px-4 py-2 bg-bg-card border border-border rounded-full text-sm font-semibold text-gray-1 tracking-wide" role="listitem" data-i18n="hero.chip2">CRO-First Execution</div>
      <div class="chip inline-flex items-center gap-2 px-4 py-2 bg-bg-card border border-border rounded-full text-sm font-semibold text-gray-1 tracking-wide" role="listitem" data-i18n="hero.chip3">Built for Scale</div>
    </div>
  </div>
</section>
