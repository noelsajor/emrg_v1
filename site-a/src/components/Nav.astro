---
import { getClient, getSiteSettings } from '@emrg/shared'
import type { SiteSettings, NavItem } from '@emrg/shared'

export interface Props {
  settings?: SiteSettings
}

const { settings: _settings } = Astro.props
const settings = _settings ?? await getSiteSettings(getClient())
const navLinks: NavItem[] = settings.mainNavigation.length > 0
  ? settings.mainNavigation
  : [
      { title: 'Services', href: '/#pillars', dataI18n: 'nav.services' },
      { title: 'Work', href: '/#work', dataI18n: 'nav.work' },
      { title: 'Process', href: '/#process', dataI18n: 'nav.process' },
      { title: 'Packages', href: '/#packages', dataI18n: 'nav.packages' },
      { title: 'About Us', href: '/about', dataI18n: 'nav.about' },
      { title: 'FAQ', href: '/#faq', dataI18n: 'nav.faq' },
      { title: 'Contact', href: '/#cta', dataI18n: 'nav.contact' },
    ]
---

<header>
  <nav id="nav" class="fixed top-0 left-0 right-0 z-[1000] h-nav flex items-center transition-all duration-300 border-b border-transparent" role="navigation" aria-label="Main navigation">
    <div class="container flex items-center justify-between">
      <a href="/" class="nav-logo flex items-center" aria-label="EMRG home">
        <img src="/images/emrg-logo.png" alt="EMRG Logo" class="logo-img h-7 w-auto block" width={300} height={61} loading="eager" decoding="async" />
      </a>

      <ul class="nav-links hidden md:flex items-center gap-2 list-none" role="list">
        {navLinks.map((link) => (
          <li><a href={link.href} class="px-3.5 py-2 text-sm font-medium text-gray-2 rounded-md hover:text-white transition-all duration-300" data-i18n={link.dataI18n}>{link.title}</a></li>
        ))}
      </ul>

      <div class="flex items-center gap-3">
        <div class="lang-toggle inline-flex items-center bg-bg-card border border-border rounded-full p-[3px] gap-[2px]" role="group" aria-label="Select language">
          <button class="lang-btn px-3 py-[5px] rounded-full text-[0.72rem] font-bold tracking-widest border-none bg-transparent text-gray-3 hover:text-gray-2 transition-all duration-300 cursor-pointer font-display leading-none active:bg-accent active:text-white" id="lang-en" aria-pressed="true" aria-label="Switch to English">EN</button>
          <button class="lang-btn px-3 py-[5px] rounded-full text-[0.72rem] font-bold tracking-widest border-none bg-transparent text-gray-3 hover:text-gray-2 transition-all duration-300 cursor-pointer font-display leading-none active:bg-accent active:text-white" id="lang-es" aria-pressed="false" aria-label="Cambiar a Español">ES</button>
        </div>
        <a href="#cta" class="hidden md:inline-flex items-center gap-2 px-5 py-2.5 rounded-lg font-display text-sm font-semibold tracking-wider border-none cursor-pointer whitespace-nowrap transition-all duration-300 bg-accent text-white hover:bg-accent-light hover:shadow-[0_0_30px_rgba(139,92,246,0.4)] hover:-translate-y-px" data-i18n="nav.cta">Book a Call</a>
        <button class="flex md:hidden flex-col gap-[5px] bg-none border-none p-1.5 cursor-pointer" id="hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
          <span class="block w-6 h-0.5 bg-white rounded-sm transition-all duration-300"></span>
          <span class="block w-6 h-0.5 bg-white rounded-sm transition-all duration-300"></span>
          <span class="block w-6 h-0.5 bg-white rounded-sm transition-all duration-300"></span>
        </button>
      </div>
    </div>
  </nav>
</header>

<nav id="mobile-menu" class="hidden fixed top-nav left-0 right-0 bottom-0 bg-[rgba(8,10,15,0.97)] backdrop-blur-xl z-[999] flex-col items-center justify-center gap-2 opacity-0 -translate-y-2.5 transition-all duration-300 pointer-events-none" aria-label="Mobile navigation" aria-hidden="true">
  {navLinks.map((link) => (
    <a href={link.href} class="mobile-link text-[1.6rem] font-bold text-gray-2 hover:text-white transition-colors duration-300" data-i18n={link.dataI18n}>{link.title}</a>
  ))}
  <a href="/#cta" class="btn btn-primary mt-6" data-i18n="hero.cta.primary">Book a 15-min Call</a>
  <div class="lang-toggle inline-flex items-center bg-bg-card border border-border rounded-full p-[3px] gap-[2px] mt-4" role="group" aria-label="Select language">
    <button class="lang-btn px-3 py-[5px] rounded-full text-[0.72rem] font-bold tracking-widest border-none bg-transparent text-gray-3 hover:text-gray-2 transition-all duration-300 cursor-pointer font-display leading-none active:bg-accent active:text-white" id="lang-en-mobile" aria-pressed="true" aria-label="Switch to English">EN</button>
    <button class="lang-btn px-3 py-[5px] rounded-full text-[0.72rem] font-bold tracking-widest border-none bg-transparent text-gray-3 hover:text-gray-2 transition-all duration-300 cursor-pointer font-display leading-none active:bg-accent active:text-white" id="lang-es-mobile" aria-pressed="false" aria-label="Cambiar a Español">ES</button>
  </div>
</nav>
