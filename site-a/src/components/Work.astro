---
---

<section id="work" class="py-section bg-bg-2" aria-labelledby="work-heading">
  <div class="container">
    <div class="flex items-end justify-between mb-16 gap-6 flex-wrap">
      <div>
        <div class="inline-flex items-center gap-2.5 text-[0.72rem] font-bold tracking-[0.14em] uppercase text-accent mb-5 before:w-5 before:h-px before:bg-accent" data-i18n="work.label">Featured Work</div>
        <h2 class="section-title text-white text-[clamp(1.8rem,3.5vw,2.8rem)] font-extrabold tracking-tight leading-tight" id="work-heading" data-i18n="work.title">Outcomes, not outputs.</h2>
      </div>
      <a href="#cta" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-lg font-display text-sm font-semibold tracking-wider border cursor-pointer whitespace-nowrap transition-all duration-300 bg-transparent text-white border-border hover:border-accent hover:text-accent-light hover:bg-[rgba(115,96,248,0.15)] hover:-translate-y-px" data-i18n="work.viewAll">View All Work</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <article class="bg-bg-card border border-border rounded-[20px] overflow-hidden transition-all duration-300 flex flex-col hover:border-[rgba(139,92,246,0.4)] hover:-translate-y-1 hover:shadow-accent reveal" aria-labelledby="case-1-brand">
        <div class="h-[200px] relative overflow-hidden thumb-1" aria-hidden="true">
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="absolute w-[150px] h-[150px] bg-[rgba(139,92,246,0.2)] rounded-full top-5 right-5" style="filter:blur(40px)"></div>
            <div class="text-center z-[1] relative">
              <div class="thumb-label">SOLERA</div>
              <div class="thumb-sub" data-i18n="work.c1.industry">Skincare DTC</div>
            </div>
          </div>
        </div>
        <div class="p-8 flex-1 flex flex-col">
          <div class="text-[0.7rem] font-bold tracking-[0.12em] uppercase text-accent mb-3" data-i18n="work.c1.tag">Shopify Build · Brand Identity</div>
          <h3 class="text-lg font-extrabold text-white tracking-tight mb-2" id="case-1-brand">Solera</h3>
          <p class="text-sm text-gray-2 mb-5 leading-relaxed" data-i18n="work.c1.problem">Entering a saturated skincare market with no digital presence. Needed a brand and store capable of converting cold traffic from day one.</p>
          <div class="flex gap-4 flex-wrap mb-7" role="list">
            <div class="bg-bg-3 border border-border rounded-lg px-3.5 py-2.5" role="listitem">
              <div class="text-base font-extrabold text-white tracking-tight text-[#34d399]">+28%</div>
              <div class="text-[0.7rem] text-gray-2 font-medium" data-i18n="work.metric.cvr">CVR vs industry avg</div>
            </div>
            <div class="bg-bg-3 border border-border rounded-lg px-3.5 py-2.5" role="listitem">
              <div class="text-base font-extrabold text-white tracking-tight text-[#34d399]">6 <span data-i18n="work.metric.days">Days</span></div>
              <div class="text-[0.7rem] text-gray-2 font-medium" data-i18n="work.metric.launch">Launch timeline</div>
            </div>
            <div class="bg-bg-3 border border-border rounded-lg px-3.5 py-2.5" role="listitem">
              <div class="text-base font-extrabold text-white tracking-tight text-[#34d399]">+19%</div>
              <div class="text-[0.7rem] text-gray-2 font-medium" data-i18n="work.metric.aov">AOV lift</div>
            </div>
          </div>
          <div class="mt-auto">
            <a href="#cta" class="inline-flex items-center gap-2 text-sm font-medium text-gray-2 hover:text-white transition-colors duration-300" id="case1-btn">
              <span data-i18n="work.readCase">Read Case Study</span>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </article>

      <article class="bg-bg-card border border-border rounded-[20px] overflow-hidden transition-all duration-300 flex flex-col hover:border-[rgba(139,92,246,0.4)] hover:-translate-y-1 hover:shadow-accent reveal reveal-delay-1" aria-labelledby="case-2-brand">
        <div class="h-[200px] relative overflow-hidden thumb-2" aria-hidden="true">
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="absolute w-[140px] h-[140px] bg-[rgba(52,211,153,0.15)] rounded-full bottom-2.5 left-5" style="filter:blur(40px)"></div>
            <div class="text-center z-[1] relative">
              <div class="thumb-label">VARKA</div>
              <div class="thumb-sub" data-i18n="work.c2.industry">Nutrition DTC</div>
            </div>
          </div>
        </div>
        <div class="p-8 flex-1 flex flex-col">
          <div class="text-[0.7rem] font-bold tracking-[0.12em] uppercase text-accent mb-3" data-i18n="work.c2.tag">WooCommerce Rebuild · Growth Systems</div>
          <h3 class="text-lg font-extrabold text-white tracking-tight mb-2" id="case-2-brand">Varka</h3>
          <p class="text-sm text-gray-2 mb-5 leading-relaxed" data-i18n="work.c2.problem">Existing WooCommerce store suffering from slow load times, poor mobile UX, and no post-purchase retention system in place.</p>
          <div class="flex gap-4 flex-wrap mb-7" role="list">
            <div class="bg-bg-3 border border-border rounded-lg px-3.5 py-2.5" role="listitem">
              <div class="text-base font-extrabold text-white tracking-tight text-[#34d399]">-42%</div>
              <div class="text-[0.7rem] text-gray-2 font-medium" data-i18n="work.metric.loadtime">Page load time</div>
            </div>
            <div class="bg-bg-3 border border-border rounded-lg px-3.5 py-2.5" role="listitem">
              <div class="text-base font-extrabold text-white tracking-tight text-[#34d399]">+22%</div>
              <div class="text-[0.7rem] text-gray-2 font-medium" data-i18n="work.metric.repeat">Repeat purchase rate</div>
            </div>
            <div class="bg-bg-3 border border-border rounded-lg px-3.5 py-2.5" role="listitem">
              <div class="text-base font-extrabold text-white tracking-tight text-[#34d399]">+14%</div>
              <div class="text-[0.7rem] text-gray-2 font-medium" data-i18n="work.metric.aov">AOV lift</div>
            </div>
          </div>
          <div class="mt-auto">
            <a href="#cta" class="inline-flex items-center gap-2 text-sm font-medium text-gray-2 hover:text-white transition-colors duration-300" id="case2-btn">
              <span data-i18n="work.readCase">Read Case Study</span>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </article>

      <article class="bg-bg-card border border-border rounded-[20px] overflow-hidden transition-all duration-300 flex flex-col hover:border-[rgba(139,92,246,0.4)] hover:-translate-y-1 hover:shadow-accent reveal reveal-delay-2" aria-labelledby="case-3-brand">
        <div class="h-[200px] relative overflow-hidden thumb-3" aria-hidden="true">
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="absolute w-[160px] h-[160px] bg-[rgba(236,72,153,0.15)] rounded-full top-0 right-0" style="filter:blur(50px)"></div>
            <div class="text-center z-[1] relative">
              <div class="thumb-label">DUNE</div>
              <div class="thumb-sub" data-i18n="work.c3.industry">Apparel DTC</div>
            </div>
          </div>
        </div>
        <div class="p-8 flex-1 flex flex-col">
          <div class="text-[0.7rem] font-bold tracking-[0.12em] uppercase text-accent mb-3" data-i18n="work.c3.tag">Shopify Build · Brand · CRO</div>
          <h3 class="text-lg font-extrabold text-white tracking-tight mb-2" id="case-3-brand">Dune</h3>
          <p class="text-sm text-gray-2 mb-5 leading-relaxed" data-i18n="work.c3.problem">Direct-to-consumer apparel brand pivoting from wholesale. Needed a flagship DTC store and full brand system built for conversion.</p>
          <div class="flex gap-4 flex-wrap mb-7" role="list">
            <div class="bg-bg-3 border border-border rounded-lg px-3.5 py-2.5" role="listitem">
              <div class="text-base font-extrabold text-white tracking-tight text-[#34d399]">+34%</div>
              <div class="text-[0.7rem] text-gray-2 font-medium" data-i18n="work.metric.cvrImprov">CVR improvement</div>
            </div>
            <div class="bg-bg-3 border border-border rounded-lg px-3.5 py-2.5" role="listitem">
              <div class="text-base font-extrabold text-white tracking-tight text-[#34d399]">7 <span data-i18n="work.metric.days">Days</span></div>
              <div class="text-[0.7rem] text-gray-2 font-medium" data-i18n="work.metric.fullLaunch">Full launch</div>
            </div>
            <div class="bg-bg-3 border border-border rounded-lg px-3.5 py-2.5" role="listitem">
              <div class="text-base font-extrabold text-white tracking-tight text-[#34d399]">3.8x</div>
              <div class="text-[0.7rem] text-gray-2 font-medium" data-i18n="work.metric.roas">ROAS month 1</div>
            </div>
          </div>
          <div class="mt-auto">
            <a href="#cta" class="inline-flex items-center gap-2 text-sm font-medium text-gray-2 hover:text-white transition-colors duration-300" id="case3-btn">
              <span data-i18n="work.readCase">Read Case Study</span>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>
