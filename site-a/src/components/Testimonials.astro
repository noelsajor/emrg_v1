<section id="testimonials" class="py-section bg-bg" aria-labelledby="testi-heading">
  <div class="container">
    <div class="inline-flex items-center gap-2.5 text-[0.72rem] font-bold tracking-[0.14em] uppercase text-accent mb-5 before:w-5 before:h-px before:bg-accent" data-i18n="testi.label">What Founders Say</div>
    <h2 class="section-title text-white text-[clamp(1.8rem,3.5vw,2.8rem)] font-extrabold tracking-tight leading-tight" id="testi-heading" data-i18n="testi.title">Trusted by builders.</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-16" role="list">
      <article class="bg-bg-card border border-border rounded-[20px] p-10 transition-all duration-300 relative hover:border-[rgba(139,92,246,0.4)] hover:-translate-y-0.5 reveal" role="listitem">
        <div class="flex gap-1 mb-5" aria-label="5 out of 5 stars">
          <span class="text-[#fbbf24] text-sm" aria-hidden="true">★</span>
          <span class="text-[#fbbf24] text-sm" aria-hidden="true">★</span>
          <span class="text-[#fbbf24] text-sm" aria-hidden="true">★</span>
          <span class="text-[#fbbf24] text-sm" aria-hidden="true">★</span>
          <span class="text-[#fbbf24] text-sm" aria-hidden="true">★</span>
