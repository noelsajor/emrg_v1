---
import type { SiteSettings } from '@emrg/shared';
import { getClient, getSiteSettings } from '@emrg/shared';

export interface Props {
  settings?: SiteSettings;
}

const { settings: _settings } = Astro.props;
const settings = _settings ?? await getSiteSettings(getClient());
const calendlyUrl = settings.calendlyUrl ?? 'https://cal.com/emrg';
---

<section id="scene-0" class="scene active" data-i18n-attr="aria-label:hero.eyebrow">
  <div class="hero-eyebrow" data-i18n="hero.eyebrow">Founder-Led Ecommerce Performance Studio</div>
  <h1 class="hero-title" data-i18n="hero.title" data-i18n-html="true">
    We Design.<br />We Build.<br />We <span class="accent">Engineer.</span>
  </h1>
  <p class="hero-sub" data-i18n="hero.sub">
    End-to-end ecommerce execution — brand identity, store engineering, and growth infrastructure for DTC brands built to win.
  </p>
  <div class="hero-cta-row">
    <a href={calendlyUrl} class="btn-primary-imm" data-i18n="hero.cta_book">Book a 15-min Call →</a>
    <button class="btn-outline-imm" onclick="goToScene(3)" data-i18n="hero.cta_work">View Work</button>
  </div>
  <div class="hero-chips">
    <span class="chip-pill" data-i18n="hero.chip1">7-Day Launch</span>
    <span class="chip-pill" data-i18n="hero.chip2">CRO-First Execution</span>
    <span class="chip-pill" data-i18n="hero.chip3">Built for Scale</span>
  </div>
</section>
