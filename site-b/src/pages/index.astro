---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '@emrg/shared/components/Nav.astro';
import Hero from '@emrg/shared/components/Hero.astro';
import Trust from '@emrg/shared/components/Trust.astro';
import Pillars from '@emrg/shared/components/Pillars.astro';
import Work from '@emrg/shared/components/Work.astro';
import Process from '@emrg/shared/components/Process.astro';
import Packages from '@emrg/shared/components/Packages.astro';
import Testimonials from '@emrg/shared/components/Testimonials.astro';
